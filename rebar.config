{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {extras, ["README.md", "BENCHMARK.md", "LICENSE"]},
    {main, "README.md"},
    {source_url, "https://github.com/altenwald/spectra"}
]}.

{escript_incl_apps, [spectra]}.
{escript_main_app, spectra}.
{escript_name, spectra}.
{escript_emu_args, "%%! +sbtu +A1\n"}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.
