{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{project_plugins, [rebar3_hex, rebar3_ex_doc, rebar3_proper]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {extras, ["README.md", "DISCREPANCIES.md", "GRADUAL.md", "LICENSE"]},
    {main, "README.md"},
    {logo, "assets/prisma.png"},
    {source_url, "https://github.com/altenwald/prisma"}
]}.

{escript_incl_apps, [prisma]}.
{escript_main_app, prisma}.
{escript_name, prisma}.
{escript_emu_args, "%%! +sbtu +A1\n"}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, [{proper, "1.5.0"}]}
    ]}
]}.
