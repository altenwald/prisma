{application, prisma, [
    {description, "Hybrid Success & Gradual Type Analyzer with Modular PLTs for Erlang and Elixir"},
    {pkg_name, "prisma"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        compiler,
        syntax_tools
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/altenwald/prisma"}
    ]},
    {files, [
        "src",
        "include",
        "assets",
        "rebar.config",
        "rebar.lock",
        "mix.exs",
        "README.md",
        "BENCHMARK.md",
        "LICENSE"
    ]}
]}.
