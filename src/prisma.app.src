{application, prisma, [
    {description, "Hybrid Success & Gradual Type Analyzer with Modular PPLTs for Erlang and Elixir"},
    {pkg_name, "prisma"},
    {vsn, "0.2.1"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        compiler,
        syntax_tools
    ]},
    {optional_applications, [
        elixir
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/altenwald/prisma"}
    ]},
    {files, [
        "src",
        "include",
        "assets/prisma.png",
        "assets/prisma.svg",
        "rebar.config",
        "rebar.lock",
        "mix.exs",
        "README.md",
        "DISCREPANCIES.md", "GRADUAL.md",
        "LICENSE"
    ]}
]}.
